    {
      "id": 100,
      "type": "state-timeline",
      "title": "History",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "legendFormat": "{{job}}",
          "expr": "min by (job) (up) * on(job) (min by (job) (service_health_status) or on(job) (min by (job) (up) * 0))"
