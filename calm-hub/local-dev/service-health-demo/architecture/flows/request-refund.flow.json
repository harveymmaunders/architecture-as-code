{
  "$schema": "https://calm.finos.org/release/1.3/meta/flow.json",
  "$id": "http://localhost:8080/calm/namespaces/service-health-demo/flows/request-refund/versions/1.1.0",
  "unique-id": "flow-request-refund",
  "name": "Request Refund",
  "description": "A customer asks for a refund of a captured payment.",
  "transitions": [
    {
      "relationship-unique-id": "customer-portal-to-api-gateway",
      "sequence-number": 1,
      "description": "Portal sends the refund request"
    },
    {
      "relationship-unique-id": "api-gateway-to-auth-service",
      "sequence-number": 2,
      "description": "Gateway validates the access token"
    },
    {
      "relationship-unique-id": "api-gateway-to-payments-api",
      "sequence-number": 3,
      "description": "Gateway routes the request to the payments API"
    },
    {
      "relationship-unique-id": "payments-api-to-central-db",
      "sequence-number": 4,
      "description": "Payments API records the refund request"
    }
  ],
  "metadata": {
    "criticality": "high"
  }
}
