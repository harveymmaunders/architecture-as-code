{
  "$schema": "https://calm.finos.org/release/1.3/meta/flow.json",
  "$id": "http://localhost:8080/calm/namespaces/service-health-demo/flows/view-order-history/versions/1.1.0",
  "unique-id": "flow-view-order-history",
  "name": "View Order History",
  "description": "A signed-in customer views past orders.",
  "transitions": [
    {
      "relationship-unique-id": "customer-portal-to-api-gateway",
      "sequence-number": 1,
      "description": "Portal requests the order history"
    },
    {
      "relationship-unique-id": "api-gateway-to-auth-service",
      "sequence-number": 2,
      "description": "Gateway validates the access token"
    },
    {
      "relationship-unique-id": "api-gateway-to-orders-api",
      "sequence-number": 3,
      "description": "Gateway routes the request to the orders API"
    },
    {
      "relationship-unique-id": "orders-api-to-central-db",
      "sequence-number": 4,
      "description": "Orders API reads the orders of the customer"
    }
  ],
  "metadata": {
    "criticality": "normal"
  }
}
