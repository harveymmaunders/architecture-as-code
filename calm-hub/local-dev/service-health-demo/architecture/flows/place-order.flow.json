{
  "$schema": "https://calm.finos.org/release/1.3/meta/flow.json",
  "$id": "http://localhost:8080/calm/namespaces/service-health-demo/flows/place-order/versions/1.1.0",
  "unique-id": "flow-place-order",
  "name": "Place Order",
  "description": "A signed-in customer places an order. The orders API authorises the payment.",
  "transitions": [
    {
      "relationship-unique-id": "customer-portal-to-api-gateway",
      "sequence-number": 1,
      "description": "Portal submits the basket"
    },
    {
      "relationship-unique-id": "api-gateway-to-auth-service",
      "sequence-number": 2,
      "description": "Gateway validates the access token"
    },
    {
      "relationship-unique-id": "api-gateway-to-orders-api",
      "sequence-number": 3,
      "description": "Gateway routes the order to the orders API"
    },
    {
      "relationship-unique-id": "orders-api-to-central-db",
      "sequence-number": 4,
      "description": "Orders API stores the new order"
    },
    {
      "relationship-unique-id": "orders-api-to-payments-api",
      "sequence-number": 5,
      "description": "Orders API asks the payments API to authorise the amount"
    },
    {
      "relationship-unique-id": "payments-api-to-central-db",
      "sequence-number": 6,
      "description": "Payments API stores the authorisation"
    }
  ],
  "metadata": {
    "criticality": "critical"
  }
}
