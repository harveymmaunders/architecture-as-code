{
  "$schema": "https://calm.finos.org/release/1.3/meta/flow.json",
  "$id": "http://localhost:8080/calm/namespaces/service-health-demo/flows/manage-saved-cards/versions/1.1.0",
  "unique-id": "flow-manage-saved-cards",
  "name": "Manage Saved Cards",
  "description": "A customer adds or removes saved cards. The gateway checks the token signature itself.",
  "transitions": [
    {
      "relationship-unique-id": "customer-portal-to-api-gateway",
      "sequence-number": 1,
      "description": "Portal sends the card change"
    },
    {
      "relationship-unique-id": "api-gateway-to-payments-api",
      "sequence-number": 2,
      "description": "Gateway routes the change to the payments API"
    },
    {
      "relationship-unique-id": "payments-api-to-central-db",
      "sequence-number": 3,
      "description": "Payments API stores the tokenised card"
    }
  ],
  "metadata": {
    "criticality": "high"
  }
}
