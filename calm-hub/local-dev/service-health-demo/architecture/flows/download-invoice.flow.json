{
  "$schema": "https://calm.finos.org/release/1.3/meta/flow.json",
  "$id": "http://localhost:8080/calm/namespaces/service-health-demo/flows/download-invoice/versions/1.1.0",
  "unique-id": "flow-download-invoice",
  "name": "Download Invoice",
  "description": "A customer downloads an invoice. The orders API gets the payment receipt from the payments API.",
  "transitions": [
    {
      "relationship-unique-id": "customer-portal-to-api-gateway",
      "sequence-number": 1,
      "description": "Portal requests the invoice"
    },
    {
      "relationship-unique-id": "api-gateway-to-auth-service",
      "sequence-number": 2,
      "description": "Gateway validates the access token"
    },
    {
      "relationship-unique-id": "api-gateway-to-orders-api",
      "sequence-number": 3,
      "description": "Gateway routes the request to the orders API"
    },
    {
      "relationship-unique-id": "orders-api-to-payments-api",
      "sequence-number": 4,
      "description": "Orders API gets the payment receipt"
    },
    {
      "relationship-unique-id": "payments-api-to-central-db",
      "sequence-number": 5,
      "description": "Payments API reads the receipt"
    }
  ],
  "metadata": {
    "criticality": "normal"
  }
}
