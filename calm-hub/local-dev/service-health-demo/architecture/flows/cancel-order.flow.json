{
  "$schema": "https://calm.finos.org/release/1.3/meta/flow.json",
  "$id": "http://localhost:8080/calm/namespaces/service-health-demo/flows/cancel-order/versions/1.1.0",
  "unique-id": "flow-cancel-order",
  "name": "Cancel Order",
  "description": "A customer cancels an order before dispatch. The payment authorisation is voided.",
  "transitions": [
    {
      "relationship-unique-id": "customer-portal-to-api-gateway",
      "sequence-number": 1,
      "description": "Portal sends the cancel request"
    },
    {
      "relationship-unique-id": "api-gateway-to-auth-service",
      "sequence-number": 2,
      "description": "Gateway validates the access token"
    },
    {
      "relationship-unique-id": "api-gateway-to-orders-api",
      "sequence-number": 3,
      "description": "Gateway routes the cancel request to the orders API"
    },
    {
      "relationship-unique-id": "orders-api-to-central-db",
      "sequence-number": 4,
      "description": "Orders API marks the order as cancelled"
    },
    {
      "relationship-unique-id": "orders-api-to-payments-api",
      "sequence-number": 5,
      "description": "Orders API asks the payments API to void the authorisation"
    },
    {
      "relationship-unique-id": "payments-api-to-central-db",
      "sequence-number": 6,
      "description": "Payments API stores the void"
    }
  ],
  "metadata": {
    "criticality": "high"
  }
}
