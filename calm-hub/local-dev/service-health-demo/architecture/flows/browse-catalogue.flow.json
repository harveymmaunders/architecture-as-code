  "unique-id": "flow-browse-catalogue",
  "name": "Browse Catalogue",
  "description": "An anonymous customer browses products and stock levels.",
  "transitions": [
    {
      "relationship-unique-id": "customer-portal-to-api-gateway",
      "sequence-number": 1,
      "description": "Portal requests the product list"
