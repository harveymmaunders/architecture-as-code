{
  "$schema": "https://calm.finos.org/release/1.3/meta/flow.json",
  "$id": "http://localhost:8080/calm/namespaces/service-health-demo/flows/payment-reconciliation/versions/1.1.0",
  "unique-id": "flow-payment-reconciliation",
  "name": "Payment Reconciliation",
  "description": "Finance staff reconcile orders against settled payments.",
  "transitions": [
    {
      "relationship-unique-id": "admin-console-to-api-gateway",
      "sequence-number": 1,
      "description": "Admin console starts the reconciliation report"
    },
    {
      "relationship-unique-id": "api-gateway-to-orders-api",
      "sequence-number": 2,
      "description": "Gateway routes the request to the orders API"
    },
    {
      "relationship-unique-id": "orders-api-to-central-db",
      "sequence-number": 3,
      "description": "Orders API reads the orders for the period"
    },
    {
      "relationship-unique-id": "orders-api-to-payments-api",
      "sequence-number": 4,
      "description": "Orders API gets the settled payments"
    },
    {
      "relationship-unique-id": "payments-api-to-central-db",
      "sequence-number": 5,
      "description": "Payments API reads the settlements"
    }
  ],
  "metadata": {
    "criticality": "normal"
  }
}
