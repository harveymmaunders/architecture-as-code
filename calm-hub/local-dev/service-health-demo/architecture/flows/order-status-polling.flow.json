{
  "$schema": "https://calm.finos.org/release/1.3/meta/flow.json",
  "$id": "http://localhost:8080/calm/namespaces/service-health-demo/flows/order-status-polling/versions/1.1.0",
  "unique-id": "flow-order-status-polling",
  "name": "Order Status Polling",
  "description": "The portal polls the status of an order. The gateway checks the token signature itself.",
  "transitions": [
    {
      "relationship-unique-id": "customer-portal-to-api-gateway",
      "sequence-number": 1,
      "description": "Portal polls the order status"
    },
    {
      "relationship-unique-id": "api-gateway-to-orders-api",
      "sequence-number": 2,
      "description": "Gateway routes the request to the orders API"
    },
    {
      "relationship-unique-id": "orders-api-to-central-db",
      "sequence-number": 3,
      "description": "Orders API reads the order status"
    }
  ],
  "metadata": {
    "criticality": "normal"
  }
}
